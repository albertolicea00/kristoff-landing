---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
	id="hero"
	class="relative flex min-h-screen items-center justify-center overflow-hidden bg-secondary pt-20"
>
	<!-- Background Pattern -->
	<div class="absolute inset-0 z-0 opacity-20">
		<div
			class="absolute inset-0 scale-150 transform bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary/30 to-secondary"
		>
		</div>
		<div
			class="h-full w-full animate-pulse bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"
		>
		</div>
	</div>

	<!-- Floating Notes Container (populated by JS) -->
	<div
		id="floating-notes"
		class="pointer-events-none absolute inset-0 z-[1] overflow-hidden"
	>
	</div>

	<div
		class="relative z-10 mx-auto flex max-w-7xl flex-col items-center px-4 text-center sm:px-6 lg:px-8"
	>
		<!-- Profile Picture (Instagram) -->
		<div
			class="mb-8 h-48 w-48 transform overflow-hidden rounded-full border-4 border-primary shadow-[0_0_30px_rgba(255,59,59,0.5)] transition-transform duration-300 hover:scale-105 md:h-64 md:w-64"
		>
			<img
				src="https://scontent-mia3-1.cdninstagram.com/v/t51.2885-19/313369687_2961448937494548_2550186981144203115_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=1-7&_nc_sid=d3d953&_nc_ohc=8x26P1AEX9IQ7kNvgFWQ8qQ&_nc_zt=24&_nc_ht=scontent-mia3-1.cdninstagram.com&oh=00_AYB7e0Qjix9x6b-VvJ1U5R15L645Tj1i2h9z1i2h9z1i2Q&oe=64E24294"
				alt="Kristoff Kriollo"
				class="h-full w-full object-cover"
				loading="eager"
				onerror="this.setAttribute('src', 'https://yt3.ggpht.com/_nwkuUvKJT-ztrUNH1bymp7trvZfDXp07UVV7NJNv-Zfws0Wpnlla9nExFRhYSVNAMeKxt9AHA=s800-c-k-c0x00ffffff-no-rj')"
			/>
		</div>

		<!-- Titles -->
		<h1
			class="mb-4 font-heading text-6xl font-bold leading-none tracking-wider text-white md:text-8xl lg:text-9xl"
		>
			KRISTOFF <span class="block text-primary md:inline">KRIOLLO</span>
		</h1>

		<h2
			id="hero-slogan"
			class="mb-6 rotate-[-2deg] transform font-heading text-2xl text-accent transition-opacity duration-500 md:text-4xl"
		>
			{t("hero.title")}
		</h2>

		<p
			class="mx-auto mb-10 max-w-2xl font-body text-lg text-gray-300 md:text-xl"
		>
			{t("hero.subtitle")}
		</p>

		<!-- CTAs -->
		<div class="flex flex-col space-y-4 sm:flex-row sm:space-x-6 sm:space-y-0">
			<a
				href="#videos"
				class="btn-primary flex items-center justify-center shadow-[0_0_20px_rgba(255,59,59,0.4)]"
			>
				<svg
					class="mr-2 h-6 w-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
					></path><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
				>
				{t("hero.cta")}
			</a>
			<a href="#collabs" class="btn-secondary">
				{t("nav.collabs")}
			</a>
		</div>

		<!-- Leave a Note (hidden for now) -->
		<div class="mt-12 hidden w-full max-w-lg">
			<form id="note-form" class="flex flex-col gap-2 sm:flex-row">
				<input
					type="text"
					id="note-username"
					placeholder="Tu nombre (opcional)"
					maxlength="20"
					class="w-full rounded-full border border-white/20 bg-white/10 px-4 py-3 font-body text-sm text-white backdrop-blur-sm placeholder:text-gray-500 sm:w-32"
				/>
				<input
					type="text"
					id="note-input"
					placeholder="Deja tu nota aquí..."
					maxlength="80"
					class="flex-1 rounded-full border border-white/20 bg-white/10 px-4 py-3 font-body text-sm text-white backdrop-blur-sm placeholder:text-gray-400"
				/>
				<button
					type="submit"
					class="rounded-full bg-primary px-6 py-3 font-heading text-sm uppercase text-white"
					>Enviar</button
				>
			</form>
		</div>
	</div>

	<!-- Scroll Down Indicator (Visual Only) -->
	<div
		class="pointer-events-none absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 transform flex-col items-center opacity-60"
	>
		<div
			class="flex h-10 w-6 justify-center rounded-full border-2 border-white p-1 drop-shadow-md"
		>
			<div
				class="h-3 w-1.5 animate-[bounce_1.5s_infinite] rounded-full bg-white"
			>
			</div>
		</div>
	</div>

	<!-- Twitch Live Popup -->
	<div
		id="twitch-popup"
		class="fixed bottom-6 right-6 z-50 hidden animate-[slideUp_0.5s_ease-out]"
	>
		<div
			class="relative max-w-sm rounded-2xl border-2 border-purple-500 bg-purple-900 p-5 shadow-[0_10px_40px_rgba(145,70,255,0.4)]"
		>
			<button
				id="close-twitch-popup"
				class="absolute -right-2 -top-2 flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-gray-600 bg-gray-800 text-sm text-white transition-colors hover:bg-red-600"
				>✕</button
			>
			<div class="mb-3 flex items-center gap-3">
				<div class="relative">
					<div class="absolute h-3 w-3 animate-ping rounded-full bg-red-500">
					</div>
					<div class="relative h-3 w-3 rounded-full bg-red-500"></div>
				</div>
				<span class="font-heading text-lg uppercase tracking-wider text-white"
					>En Vivo Ahora</span
				>
			</div>
			<p class="mb-4 font-body text-sm text-purple-200">
				¡Kristoff está en directo en Twitch! Entra pa' la locura 🔥
			</p>
			<a
				href="https://www.twitch.tv/kristoff_kriollo"
				target="_blank"
				class="block w-full rounded-xl bg-purple-600 py-3 text-center font-heading uppercase tracking-wider text-white transition-colors hover:bg-purple-500 active:scale-95"
			>
				<svg class="mr-2 inline h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
					><path
						d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"
					></path></svg
				>
				Ver en Twitch
			</a>
		</div>
	</div>
</section>

<script>
	// ===== TWITCH LIVE POPUP =====
	async function checkTwitchLive() {
		try {
			const res = await fetch("https://gql.twitch.tv/gql", {
				method: "POST",
				headers: { "Client-Id": "kimne78kx3ncx6brgo4mv6wki5h1ko" },
				body: JSON.stringify({
					query: `query { user(login: "kristoff_kriollo") { stream { id type viewersCount } } }`,
				}),
			});
			const data = await res.json();
			const stream = data?.data?.user?.stream;

			if (stream && !sessionStorage.getItem("twitch-popup-closed")) {
				const popup = document.getElementById("twitch-popup");
				if (popup) {
					popup.classList.remove("hidden");
				}
			}
		} catch (_) {
			/* silent */
		}
	}

	const closeBtn = document.getElementById("close-twitch-popup");
	if (closeBtn) {
		closeBtn.addEventListener("click", () => {
			const popup = document.getElementById("twitch-popup");
			if (popup) popup.classList.add("hidden");
			sessionStorage.setItem("twitch-popup-closed", "true");
		});
	}

	checkTwitchLive();

	// ===== FLOATING NOTES =====
	const demoNotes = [
		{ text: "Kristoff el mejor 🇨🇺🔥", username: "ElCubano" },
		{ text: "Miami se siente 🌴", username: null },
		{ text: "El contenido más real del internet", username: "LaFlaca305" },
		{ text: "Asere qué bolá!!!", username: null },
		{ text: "Desde La Habana con amor ❤️", username: "Yoandy" },
		{ text: "La 826 me tiene loco 😂", username: "MiamiTraffic" },
		{ text: "Croquetas > todo lo demás", username: null },
		{ text: "Kristoff pa presidente 🗳️", username: "VotaCubano" },
		{ text: "100% Cubano sin filtro", username: "RealTalk" },
		{ text: "El podcast está on fire 🎙️", username: null },
	];

	interface NoteData {
		text: string;
		username: string | null;
	}

	async function fetchNotes(): Promise<NoteData[]> {
		return demoNotes;
	}

	async function submitNote(_text: string, _username: string | null) {
		return true;
	}

	function createFloatingNote(noteData: NoteData, container: HTMLElement) {
		const note = document.createElement("div");
		note.className = "absolute pointer-events-none select-none";

		// Build styled content
		if (noteData.username) {
			note.innerHTML = `<span style="color:rgba(255,214,0,0.4);font-weight:700;">@${noteData.username}</span> <span style="color:rgba(255,255,255,0.25);">${noteData.text}</span>`;
		} else {
			note.innerHTML = `<span style="color:rgba(255,255,255,0.2);">${noteData.text}</span>`;
		}

		note.style.fontFamily = "Poppins, sans-serif";
		note.style.fontSize = `${0.75 + Math.random() * 0.35}rem`;
		note.style.whiteSpace = "nowrap";
		note.style.padding = "4px 12px";
		note.style.borderRadius = "999px";
		note.style.background = "rgba(255,255,255,0.03)";
		note.style.backdropFilter = "blur(2px)";
		note.style.border = "1px solid rgba(255,255,255,0.05)";

		// Position on edges only (avoid center where content is)
		const edge = Math.floor(Math.random() * 4);
		if (edge === 0) {
			// top area
			note.style.top = `${5 + Math.random() * 15}%`;
			note.style.left = `${Math.random() * 70 + 5}%`;
		} else if (edge === 1) {
			// bottom area
			note.style.top = `${75 + Math.random() * 20}%`;
			note.style.left = `${Math.random() * 70 + 5}%`;
		} else if (edge === 2) {
			// left edge
			note.style.top = `${20 + Math.random() * 55}%`;
			note.style.left = `${Math.random() * 15}%`;
		} else {
			// right edge
			note.style.top = `${20 + Math.random() * 55}%`;
			note.style.right = `${Math.random() * 15}%`;
		}

		const duration = 20 + Math.random() * 20;
		const delay = Math.random() * 8;
		const rotate = (Math.random() - 0.5) * 12;
		note.style.transform = `rotate(${rotate}deg)`;
		note.style.animation = `floatNote ${duration}s ease-in-out ${delay}s infinite`;

		container.appendChild(note);
	}

	async function initNotes() {
		const container = document.getElementById("floating-notes");
		if (!container) return;

		const notes = await fetchNotes();
		notes.forEach((n) => createFloatingNote(n, container));
	}

	// Form submission
	const form = document.getElementById("note-form") as HTMLFormElement;
	const input = document.getElementById("note-input") as HTMLInputElement;
	const usernameInput = document.getElementById(
		"note-username"
	) as HTMLInputElement;

	if (form && input) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const text = input.value.trim();
			if (!text || text.length < 2) return;

			const username = usernameInput?.value.trim() || null;

			input.disabled = true;
			if (usernameInput) usernameInput.disabled = true;
			const btn = form.querySelector("button");
			if (btn) btn.textContent = "...";

			const ok = await submitNote(text, username);

			const container = document.getElementById("floating-notes");
			if (container) {
				createFloatingNote({ text, username }, container);
			}

			input.value = "";
			input.disabled = false;
			if (usernameInput) usernameInput.disabled = false;
			if (btn) btn.textContent = ok ? "✓ Enviado" : "Enviar";
			setTimeout(() => {
				if (btn) btn.textContent = "Enviar";
			}, 2000);
		});
	}

	// ===== DYNAMIC SLOGAN =====
	const sloganEl = document.getElementById("hero-slogan");
	const slogans = ["El animaaaaal", "El astroboy"];
	let currentSloganIndex = 0;

	if (sloganEl) {
		setInterval(() => {
			sloganEl.style.opacity = "0";
			setTimeout(() => {
				currentSloganIndex = (currentSloganIndex + 1) % slogans.length;
				sloganEl.textContent = slogans[currentSloganIndex];
				sloganEl.style.opacity = "1";
			}, 500);
		}, 3000);
	}

	initNotes();
</script>

<style>
	@keyframes slideUp {
		from {
			transform: translateY(100px);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}
	@keyframes floatNote {
		0%,
		100% {
			transform: translateY(0) translateX(0);
			opacity: 0.7;
		}
		15% {
			opacity: 1;
		}
		25% {
			transform: translateY(-12px) translateX(8px);
		}
		50% {
			transform: translateY(6px) translateX(-6px);
			opacity: 0.9;
		}
		75% {
			transform: translateY(-8px) translateX(12px);
		}
		85% {
			opacity: 1;
		}
	}
</style>
