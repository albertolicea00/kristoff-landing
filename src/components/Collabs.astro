---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="collabs" class="bg-background py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			class="flex flex-col overflow-hidden rounded-3xl border-4 border-secondary bg-secondary text-white shadow-2xl lg:flex-row"
		>
			<!-- Left side: Info -->
			<div
				class="relative flex flex-col justify-center bg-gradient-to-br from-secondary to-gray-900 p-12 lg:w-5/12 lg:p-16"
			>
				<div
					class="absolute right-0 top-0 h-64 w-64 rounded-bl-full bg-primary opacity-10"
				>
				</div>
				<h2
					class="mb-6 font-heading text-5xl uppercase leading-none tracking-widest text-primary lg:text-7xl"
				>
					{t("collabs.title")}
				</h2>
				<p
					class="mb-8 border-l-4 border-accent pl-4 font-body text-xl leading-relaxed text-gray-300"
				>
					{t("collabs.description")}
				</p>

				<div class="mb-4 flex space-x-4">
					<span
						class="rounded-full border-2 border-gray-700 px-4 py-1 font-heading uppercase text-gray-400"
						>Promociones</span
					>
					<span
						class="rounded-full border-2 border-accent px-4 py-1 font-heading uppercase text-accent"
						>Eventos</span
					>
				</div>
				<div class="flex space-x-4">
					<span
						class="rounded-full border-2 border-primary px-4 py-1 font-heading uppercase text-primary"
						>Campañas</span
					>
				</div>
			</div>

			<!-- Right side: Form -->
			<div class="bg-white p-12 text-secondary lg:w-7/12 lg:p-16">
				<form id="collabs-form" class="space-y-6">
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
						<div>
							<label
								class="mb-2 block font-heading text-xl uppercase text-gray-700"
								>{t("collabs.form.name")}</label
							>
							<input
								type="text"
								required
								class="w-full rounded-lg border-2 border-gray-200 bg-gray-100 px-4 py-3 font-body transition-colors focus:border-primary focus:outline-none focus:ring-0"
							/>
						</div>
						<div>
							<label
								class="mb-2 block font-heading text-xl uppercase text-gray-700"
								>{t("collabs.form.email")}</label
							>
							<input
								type="email"
								required
								class="w-full rounded-lg border-2 border-gray-200 bg-gray-100 px-4 py-3 font-body transition-colors focus:border-primary focus:outline-none focus:ring-0"
							/>
						</div>
					</div>

					<div>
						<label
							class="mb-2 block font-heading text-xl uppercase text-gray-700"
							>{t("collabs.form.brand")}</label
						>
						<input
							type="text"
							class="w-full rounded-lg border-2 border-gray-200 bg-gray-100 px-4 py-3 font-body transition-colors focus:border-primary focus:outline-none focus:ring-0"
						/>
					</div>

					<div>
						<label
							class="mb-2 block font-heading text-xl uppercase text-gray-700"
							>{t("collabs.form.message")}</label
						>
						<textarea
							required
							rows="4"
							class="w-full resize-none rounded-lg border-2 border-gray-200 bg-gray-100 px-4 py-3 font-body transition-colors focus:border-primary focus:outline-none focus:ring-0"
						></textarea>
					</div>

					<button
						type="submit"
						disabled
						class="flex w-full cursor-not-allowed items-center justify-center rounded-xl bg-gray-400 py-4 font-heading text-2xl uppercase tracking-wider text-white shadow-lg"
					>
						{t("collabs.form.submit")} (Próximamente)
					</button>
				</form>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("collabs-form");
	if (form) {
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			alert("Formulario enviado! (Demostración)");
		});
	}
</script>
