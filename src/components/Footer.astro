---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="border-t-8 border-primary bg-secondary py-12 text-white">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			class="grid grid-cols-1 gap-12 text-center md:grid-cols-3 md:text-left"
		>
			<!-- Info -->
			<div class="flex flex-col items-center space-y-4 md:items-start">
				<span class="font-heading text-5xl tracking-widest text-primary"
					>KRIOLLO</span
				>
				<p class="max-w-xs font-body text-gray-400">{t("hero.subtitle")}</p>
			</div>

			<!-- Social Links -->
			<div class="flex flex-col items-center space-y-4 md:items-start">
				<h3 class="font-heading text-2xl uppercase tracking-widest text-accent">
					Socials
				</h3>
				<div class="flex space-x-5">
					<a
						href="https://www.youtube.com/@Kristoff9"
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-400 transition-colors hover:text-primary"
					>
						<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24"
							><path
								fill-rule="evenodd"
								d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z"
								clip-rule="evenodd"></path></svg
						>
					</a>
					<a
						href="https://www.tiktok.com/@kristoff_y"
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-400 transition-colors hover:text-white"
					>
						<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 448 512"
							><path
								d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"
							></path></svg
						>
					</a>
					<a
						href="https://www.instagram.com/kristoff_kriollo/"
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-400 transition-colors hover:text-pink-500"
					>
						<svg
							class="h-7 w-7"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							viewBox="0 0 24 24"
							><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
							></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
							></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg
						>
					</a>
					<a
						href="https://www.twitch.tv/kristoff_kriollo"
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-400 transition-colors hover:text-purple-500"
					>
						<svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24"
							><path
								d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"
							></path></svg
						>
					</a>
				</div>
			</div>

			<!-- Newsletter & Developers -->
			<div class="flex flex-col items-center space-y-4 md:items-start">
				<h3 class="font-heading text-2xl uppercase tracking-widest text-accent">
					{t("footer.newsletter")}
				</h3>
				<form class="flex w-full space-x-2">
					<input
						disabled
						type="email"
						placeholder={t("footer.newsletter.placeholder")}
						class="w-full cursor-not-allowed rounded border border-gray-700 bg-gray-800 px-4 py-3 font-body text-sm text-gray-500"
					/>
					<button
						disabled
						type="submit"
						class="cursor-not-allowed rounded bg-gray-700 px-5 py-3 font-heading text-lg uppercase tracking-wider text-gray-400 shadow-none"
					>
						{t("footer.newsletter.submit")}
					</button>
				</form>

				<!-- For Developers (Mini) -->
				<div
					class="mt-2 flex w-full flex-col items-center justify-between gap-4 border-t border-gray-800 pt-4 text-left sm:flex-row"
				>
					<p class="font-body text-xs text-gray-400">
						¿Eres developer? Únete al equipo y crea herramientas de la
						comunidad.
					</p>
					<a
						href="/developers"
						class="whitespace-nowrap rounded border border-gray-700 bg-gray-800 px-3 py-1.5 font-heading text-[10px] uppercase tracking-wider text-gray-300 transition-colors hover:bg-gray-700"
					>
						Más info
					</a>
				</div>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-800 pt-8 font-body text-sm text-gray-500 md:flex-row"
		>
			<p>
				&copy; {new Date().getFullYear()} Kristoff Kriollo. {t("footer.rights")}
			</p>
			<div class="flex gap-6">
				<a href="/developers" class="transition-colors hover:text-gray-300"
					>Developers</a
				>
				<a href="/projects" class="transition-colors hover:text-gray-300"
					>Proyectos</a
				>
			</div>
		</div>
	</div>
</footer>
