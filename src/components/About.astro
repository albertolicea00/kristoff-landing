---

<section
	id="about"
	class="relative overflow-hidden bg-secondary py-24 text-white"
>
	<div
		class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-primary opacity-20 blur-[100px] filter"
	>
	</div>
	<div
		class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-accent opacity-20 blur-[100px] filter"
	>
	</div>

	<div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<!-- Header -->
		<div class="mb-12 text-center">
			<h2
				class="mb-4 font-heading text-5xl tracking-wide text-primary drop-shadow-md md:text-7xl"
			>
				<!-- {t("about.title")} -->
			</h2>
			<div class="mx-auto mb-4 h-2 w-24 bg-accent"></div>
			<p class="font-body text-sm text-gray-500">
				Si eres fan, deja tu huella: edita esta sección y pon un dato épico
				sobre mí. Jumm 😎
			</p>
		</div>

		<!-- Editable Bio Card -->
		<div
			class="group relative rounded-2xl border border-gray-700 bg-gray-900/80 p-8 shadow-2xl backdrop-blur-sm md:p-12"
		>
			<!-- View Mode -->
			<div id="bio-view">
				<p
					id="bio-text"
					class="whitespace-pre-line font-body text-xl leading-relaxed text-gray-200 md:text-2xl"
				>
					<!-- {bioContent} -->
				</p>

				<div
					class="mt-8 flex flex-col items-center justify-between gap-4 sm:flex-row"
				>
					<!-- 
          <div class="flex items-center space-x-4">
            <span class="font-heading text-4xl text-gray-600 transform -rotate-6">Kristoff</span>
            <span class="text-gray-600 font-body text-sm" id="bio-last-edit"></span>
          </div>
           -->
					<button
						id="bio-edit-btn"
						class="flex hidden items-center gap-2 rounded-xl border border-gray-600 bg-gray-800 px-5 py-2.5 font-heading text-sm uppercase tracking-wider text-gray-300 transition-all hover:border-primary hover:bg-gray-700 hover:text-white active:scale-95"
					>
						<svg
							class="h-4 w-4"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
							></path></svg
						>
						Editar
					</button>
				</div>
			</div>

			<!-- Edit Mode (hidden by default) -->
			<div id="bio-edit" class="hidden">
				<textarea
					id="bio-textarea"
					rows="8"
					maxlength="1000"
					class="w-full resize-none rounded-xl border border-gray-600 bg-gray-800 p-6 font-body text-lg leading-relaxed text-gray-200 transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
					placeholder="Escribe sobre Kristoff..."></textarea>
				<div class="mt-4 flex items-center justify-between">
					<span id="bio-char-count" class="font-body text-sm text-gray-500"
						>0/1000</span
					>
					<div class="flex gap-3">
						<button
							id="bio-cancel-btn"
							class="rounded-xl border border-gray-600 bg-gray-800 px-5 py-2.5 font-heading text-sm uppercase tracking-wider text-gray-300 transition-all hover:bg-gray-700 active:scale-95"
						>
							Cancelar
						</button>
						<button
							id="bio-save-btn"
							class="flex items-center gap-2 rounded-xl bg-primary px-6 py-2.5 font-heading text-sm uppercase tracking-wider text-white shadow-lg transition-all hover:bg-red-600 active:scale-95"
						>
							<svg
								class="h-4 w-4"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M5 13l4 4L19 7"></path></svg
							>
							Guardar
						</button>
					</div>
				</div>
				<p id="bio-error" class="mt-2 hidden font-body text-sm text-red-400">
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	const COOLDOWN_KEY = "bio_last_edit_ts";

	function canEditToday(): boolean {
		const lastEdit = localStorage.getItem(COOLDOWN_KEY);
		if (!lastEdit) return true;
		const lastDate = new Date(parseInt(lastEdit));
		const now = new Date();
		return lastDate.toDateString() !== now.toDateString();
	}

	const bioView = document.getElementById("bio-view");
	const bioEdit = document.getElementById("bio-edit");
	const bioText = document.getElementById("bio-text");
	const bioTextarea = document.getElementById(
		"bio-textarea"
	) as HTMLTextAreaElement;
	const editBtn = document.getElementById("bio-edit-btn");
	const cancelBtn = document.getElementById("bio-cancel-btn");
	const saveBtn = document.getElementById("bio-save-btn");
	const charCount = document.getElementById("bio-char-count");
	const errorEl = document.getElementById("bio-error");

	// Enter edit mode
	if (editBtn) {
		editBtn.addEventListener("click", () => {
			if (!canEditToday()) {
				if (errorEl) {
					errorEl.textContent =
						"⏰ Ya editaste hoy. Vuelve mañana pa' meter mano otra vez.";
					errorEl.classList.remove("hidden");
					setTimeout(() => errorEl.classList.add("hidden"), 4000);
				}
				return;
			}
			if (bioTextarea && bioText) {
				bioTextarea.value = bioText.textContent?.trim() || "";
				updateCharCount();
			}
			bioView?.classList.add("hidden");
			bioEdit?.classList.remove("hidden");
			bioTextarea?.focus();
		});
	}

	// Cancel
	if (cancelBtn) {
		cancelBtn.addEventListener("click", () => {
			bioEdit?.classList.add("hidden");
			bioView?.classList.remove("hidden");
			if (errorEl) errorEl.classList.add("hidden");
		});
	}

	// Char counter
	function updateCharCount() {
		if (charCount && bioTextarea) {
			charCount.textContent = `${bioTextarea.value.length}/1000`;
		}
	}
	bioTextarea?.addEventListener("input", updateCharCount);

	// Save
	if (saveBtn) {
		saveBtn.addEventListener("click", async () => {
			if (!bioTextarea || !bioText) return;

			const newContent = bioTextarea.value.trim();
			if (newContent.length < 10) {
				if (errorEl) {
					errorEl.textContent = "Escribe al menos 10 caracteres, asere.";
					errorEl.classList.remove("hidden");
				}
				return;
			}

			saveBtn.textContent = "Guardando...";
			(saveBtn as HTMLButtonElement).disabled = true;

			const saved = true; // demo mode

			if (saved) {
				bioText.textContent = newContent;
				localStorage.setItem(COOLDOWN_KEY, Date.now().toString());
				bioEdit?.classList.add("hidden");
				bioView?.classList.remove("hidden");
				if (errorEl) errorEl.classList.add("hidden");
			} else {
				if (errorEl) {
					errorEl.textContent = "Error guardando. Intenta de nuevo.";
					errorEl.classList.remove("hidden");
				}
			}

			saveBtn.innerHTML =
				'<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Guardar';
			(saveBtn as HTMLButtonElement).disabled = false;
		});
	}
</script>
