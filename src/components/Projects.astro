---
const projects = [
	{
		title: "Rancho Kristoff",
		description:
			"Ranking interactivo de provincias cubanas con mapa en vivo, votación en tiempo real y 261K+ votos. ¡Representa tu provincia!",
		status: "Activo",
		statusColor: "bg-green-500",
		icon: "🇨🇺",
		tags: ["Mapa", "Ranking", "Votación", "En Vivo"],
		url: "https://ranchokristoff.web.app/",
		image:
			"https://images.unsplash.com/photo-1524661135-423995f22d0b?w=800&q=80",
	},
	{
		title: "Tortilla TV",
		description:
			"Video chat aleatorio estilo Omegle para la comunidad. Conecta 1v1 o en salas especiales con Kristoff como host.",
		status: "Activo",
		statusColor: "bg-green-500",
		icon: "📺",
		tags: ["Video Chat", "1v1", "Comunidad", "Live"],
		url: "https://www.tortillatv.com/",
		image:
			"https://images.unsplash.com/photo-1611162617474-5b21e879e113?w=800&q=80",
	},
	{
		title: "Kristoff Trivia",
		description:
			"¿Cuánto sabes de Kristoff? Quiz interactivo con preguntas sobre sus videos, frases y momentos épicos.",
		status: "Próximamente",
		statusColor: "bg-blue-500",
		icon: "🧠",
		tags: ["Juego", "Trivia", "Interactivo"],
		url: "#",
		image:
			"https://images.unsplash.com/photo-1606326608606-aa0b62935f2b?w=800&q=80",
	},
];
---

<section id="projects" class="relative bg-background py-24">
	<div
		class="absolute inset-0 opacity-5"
		style="background-image: radial-gradient(#111 1px, transparent 1px); background-size: 25px 25px;"
	>
	</div>

	<div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-16 text-center">
			<h2
				class="mb-4 font-heading text-5xl uppercase tracking-widest text-primary md:text-7xl"
			>
				Proyectos
			</h2>
			<p class="mx-auto max-w-2xl font-body text-xl text-gray-500">
				Apps y herramientas creadas por la comunidad para la comunidad. ¿Eres
				developer? <a
					href="/developers"
					class="font-semibold text-primary hover:underline"
					>Únete al equipo →</a
				>
			</p>
		</div>

		<!-- Visual Scroll Indicator -->
		<div class="mb-4 flex justify-end pr-4 sm:pr-0">
			<div
				class="inline-flex animate-[pulse_1.5s_infinite] items-center rounded-full bg-gray-100 p-2 text-gray-500 opacity-60"
			>
				<svg
					class="h-6 w-6"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					viewBox="0 0 24 24"
				>
					<path d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
				</svg>
			</div>
		</div>

		<div
			class="hide-scrollbar -mx-4 mb-12 flex snap-x snap-mandatory items-stretch gap-6 overflow-x-auto px-4 pb-8 sm:mx-0 sm:px-0"
		>
			{
				projects.map((project) => (
					<div class="group flex w-[85vw] shrink-0 transform snap-center flex-col overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl sm:w-[350px] sm:snap-start lg:w-[400px]">
						{/* Image Header */}
						<div class="relative h-48 w-full overflow-hidden bg-gray-900 sm:h-56">
							<img
								src={project.image}
								alt={project.title}
								class="h-full w-full object-cover opacity-80 transition-all duration-500 group-hover:scale-110 group-hover:opacity-100"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

							<div class="absolute right-4 top-4">
								<span
									class={`${project.statusColor} rounded-full px-3 py-1 font-heading text-[10px] uppercase tracking-wider text-white shadow-lg`}
								>
									{project.status}
								</span>
							</div>

							<div class="absolute bottom-4 left-4 flex items-center gap-3">
								<span class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-4xl shadow-lg drop-shadow-lg">
									{project.icon}
								</span>
								<h3 class="font-heading text-2xl uppercase tracking-wide text-white drop-shadow-md">
									{project.title}
								</h3>
							</div>
						</div>

						<div class="flex flex-1 flex-col p-6">
							{/* Description */}
							<p class="mb-6 flex-1 font-body text-sm leading-relaxed text-gray-500">
								{project.description}
							</p>

							{/* Tags */}
							<div class="mb-6 flex flex-wrap gap-1.5">
								{project.tags.map((tag) => (
									<span class="rounded bg-gray-100 px-2 py-0.5 font-body text-xs text-gray-600">
										{tag}
									</span>
								))}
							</div>

							{/* CTA */}
							{project.url !== "#" ? (
								<a
									href={project.url}
									target="_blank"
									class="mt-auto rounded-xl bg-secondary py-3 text-center font-heading text-sm uppercase tracking-wider text-white shadow-md transition-colors hover:bg-primary"
								>
									Ver App
								</a>
							) : (
								<div class="mt-auto cursor-default rounded-xl bg-gray-100 py-3 text-center font-heading text-sm uppercase tracking-wider text-gray-400">
									Próximamente
								</div>
							)}
						</div>
					</div>
				))
			}
		</div>

		<style>
			.hide-scrollbar::-webkit-scrollbar {
				display: none;
			}
			.hide-scrollbar {
				-ms-overflow-style: none; /* IE and Edge */
				scrollbar-width: none; /* Firefox */
			}
		</style>

		<div class="text-center">
			<a
				href="/projects"
				class="inline-flex transform items-center gap-2 font-heading text-xl uppercase tracking-wider text-secondary transition-colors duration-300 hover:translate-x-2 hover:text-primary"
			>
				Ver todos los proyectos <span class="text-2xl">→</span>
			</a>
		</div>
	</div>
</section>
