---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { fetchLatestVideos } from "../utils/youtube";
import { getTwitchStatus } from "../utils/social";

interface VideoData {
	id: string;
	title: string;
	time: string;
	thumbnail: string;
	link: string;
	channel: string;
	isUpcoming?: boolean;
	isMembersOnly?: boolean;
	premiereTime?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const youtubeApiKey = import.meta.env.PUBLIC_YOUTUBE_API_KEY?.trim() || "";
const useRealtimeVideos = youtubeApiKey.length > 0;
const loadingCards = Array.from({ length: 3 });

let mainVideos: VideoData[] = [];
let vodVideos: VideoData[] = [];
let podcastVideos: VideoData[] = [];
let isTwitchLive = false;

if (!useRealtimeVideos) {
	const latestVideos = await fetchLatestVideos();
	mainVideos = latestVideos.mainVideos;
	vodVideos = latestVideos.vodVideos;
	podcastVideos = latestVideos.podcastVideos;
	isTwitchLive = Boolean(await getTwitchStatus());
}

const copy =
	lang === "es"
		? {
				liveTitle: "KRISTOFF ESTA EN DIRECTO AHORA",
				liveSubtitle: "Entra pa' que goces con la locura en Twitch",
				viewLive: "Ver Directo",
				mainChannelSubtitle: "@Kristoff9 — Canal principal",
				mainChannelLink: "Ver canal",
				vodChannelSubtitle: "@Kristoffvod — Streams y momentos completos",
				podcastBadge: "Ultimo del Podcast",
				podcastDescription:
					'No te pierdas el episodio mas reciente de "Esto No Es Un Podcast Miami". Kristoff y el equipo debatiendo lo que nadie se atreve.',
				watchEpisode: "Ver Episodio",
				allEpisodes: "Todos los episodios",
				errorText: "No se pudieron cargar los videos ahora mismo.",
				emptyText: "No hay videos disponibles ahora mismo.",
				mainBadge: "Kristoff",
				vodBadge: "TV",
			}
		: {
				liveTitle: "KRISTOFF IS LIVE RIGHT NOW",
				liveSubtitle: "Jump into the chaos on Twitch.",
				viewLive: "Watch Live",
				mainChannelSubtitle: "@Kristoff9 — Main channel",
				mainChannelLink: "View channel",
				vodChannelSubtitle: "@Kristoffvod — Full streams and highlights",
				podcastBadge: "Latest Podcast Episode",
				podcastDescription:
					'Catch the newest episode of "Esto No Es Un Podcast Miami". Kristoff and the crew talking about what nobody else dares to touch.',
				watchEpisode: "Watch Episode",
				allEpisodes: "All Episodes",
				errorText: "Videos could not be loaded right now.",
				emptyText: "No videos are available right now.",
				mainBadge: "Kristoff",
				vodBadge: "TV",
			};
---

<section
	id="videos"
	class="bg-background py-24"
	data-videos-root
	data-youtube-api-key={youtubeApiKey}
	data-lang={lang}
	data-error-text={copy.errorText}
	data-empty-text={copy.emptyText}
	data-main-badge={copy.mainBadge}
	data-vod-badge={copy.vodBadge}
	data-podcast-badge={copy.podcastBadge}
	data-podcast-description={copy.podcastDescription}
	data-watch-episode={copy.watchEpisode}
	data-all-episodes={copy.allEpisodes}
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div
			id="twitch-live-banner"
			class:list={[
				"mb-12 flex transform flex-col items-center justify-between rounded-lg border-l-8 border-purple-500 bg-purple-900 p-6 shadow-xl transition-transform hover:scale-[1.01] md:flex-row",
				(useRealtimeVideos || !isTwitchLive) && "hidden",
			]}
		>
			<div class="mb-4 flex items-center space-x-4 md:mb-0">
				<div class="relative">
					<div class="absolute h-4 w-4 animate-ping rounded-full bg-red-500">
					</div>
					<div class="relative z-10 h-4 w-4 rounded-full bg-red-500"></div>
				</div>
				<div>
					<h3
						class="m-0 font-heading text-2xl uppercase tracking-widest text-white"
					>
						{copy.liveTitle}
					</h3>
					<p class="m-0 font-body text-purple-200">{copy.liveSubtitle}</p>
				</div>
			</div>
			<a
				href="https://www.twitch.tv/kristoff_kriollo"
				target="_blank"
				rel="noopener noreferrer"
				class="w-full rounded bg-purple-600 px-8 py-3 text-center font-heading text-xl uppercase tracking-wider text-white shadow-lg transition-all hover:bg-purple-500 active:scale-95 md:w-auto"
			>
				{copy.viewLive}
			</a>
		</div>

		<div class="mb-12 flex items-end justify-between">
			<div>
				<h2 class="section-title mb-0 text-primary">{t("videos.title")}</h2>
				<p class="mt-1 font-body text-sm text-gray-400">
					{copy.mainChannelSubtitle}
				</p>
			</div>
			<a
				href="https://www.youtube.com/@Kristoff9"
				target="_blank"
				rel="noopener noreferrer"
				class="hidden transform items-center font-heading text-xl uppercase tracking-wider text-secondary transition-colors duration-300 hover:translate-x-2 hover:text-primary md:flex"
			>
				{copy.mainChannelLink}
				<span class="ml-2 text-2xl">→</span>
			</a>
		</div>

		<div
			id="main-videos-grid"
			class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
		>
			{
				useRealtimeVideos
					? loadingCards.map(() => (
							<article
								class="animate-pulse overflow-hidden rounded-xl border border-gray-100 bg-white shadow-md"
								aria-hidden="true"
							>
								<div class="aspect-video border-b-4 border-primary bg-gray-200" />
								<div class="p-5">
									<div class="mb-3 h-4 w-full rounded bg-gray-200" />
									<div class="mb-4 h-4 w-4/5 rounded bg-gray-100" />
									<div class="flex gap-2">
										<div class="h-5 w-20 rounded bg-red-100" />
										<div class="h-5 w-24 rounded bg-gray-100" />
									</div>
								</div>
							</article>
						))
					: (mainVideos || []).map((video) => (
							<a
								href={video.link}
								target="_blank"
								rel="noopener noreferrer"
								class="group block transform cursor-pointer overflow-hidden rounded-xl border border-gray-100 bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
							>
								<div class="relative aspect-video w-full border-b-4 border-primary bg-gray-900">
									<img
										src={video.thumbnail}
										alt={video.title}
										class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
										loading="lazy"
									/>
									<div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-secondary/80 to-transparent opacity-0 transition-all group-hover:opacity-100">
										<div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary shadow-[0_0_20px_rgba(255,59,59,0.6)]">
											<svg
												class="ml-1 h-8 w-8 text-white"
												fill="currentColor"
												viewBox="0 0 20 20"
											>
												<path
													fill-rule="evenodd"
													d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
													clip-rule="evenodd"
												/>
											</svg>
										</div>
									</div>
								</div>
								<div class="p-5">
									<h3 class="mb-2 line-clamp-2 font-body text-base font-bold leading-tight text-secondary transition-colors group-hover:text-primary">
										{video.title}
									</h3>
									<div class="flex flex-wrap gap-2">
										<span class="flex w-fit items-center rounded bg-red-50 px-2 py-0.5 font-body text-xs font-medium text-primary">
											<svg
												class="mr-1 h-3.5 w-3.5"
												fill="currentColor"
												viewBox="0 0 24 24"
											>
												<path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" />
											</svg>
											{copy.mainBadge}
										</span>
										{video.isUpcoming && (
											<span class="animate-pulse rounded bg-blue-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
												Próximamente: {video.premiereTime}
											</span>
										)}
										{video.isMembersOnly && (
											<span class="rounded bg-green-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
												Solo Miembros
											</span>
										)}
									</div>
								</div>
							</a>
						))
			}
		</div>

		<div
			id="vod-section"
			class:list={[!useRealtimeVideos && vodVideos.length === 0 && "hidden"]}
		>
			<div
				class="mb-12 flex items-end justify-between border-t-2 border-gray-100 pt-16"
			>
				<div>
					<h2 class="section-title mb-0 text-secondary">
						Kristoff <span class="text-accent">TV</span>
					</h2>
					<p class="mt-1 font-body text-sm text-gray-400">
						{copy.vodChannelSubtitle}
					</p>
				</div>
				<a
					href="https://www.youtube.com/@Kristoffvod"
					target="_blank"
					rel="noopener noreferrer"
					class="hidden transform items-center font-heading text-xl uppercase tracking-wider text-secondary transition-colors duration-300 hover:translate-x-2 hover:text-primary md:flex"
				>
					{copy.mainChannelLink}
					<span class="ml-2 text-2xl">→</span>
				</a>
			</div>

			<div
				id="vod-videos-grid"
				class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
			>
				{
					useRealtimeVideos
						? loadingCards.map(() => (
								<article
									class="animate-pulse overflow-hidden rounded-xl border border-gray-100 bg-white shadow-md"
									aria-hidden="true"
								>
									<div class="aspect-video border-b-4 border-accent bg-gray-200" />
									<div class="p-5">
										<div class="mb-3 h-4 w-full rounded bg-gray-200" />
										<div class="mb-4 h-4 w-4/5 rounded bg-gray-100" />
										<div class="flex gap-2">
											<div class="h-5 w-16 rounded bg-yellow-100" />
											<div class="h-5 w-24 rounded bg-gray-100" />
										</div>
									</div>
								</article>
							))
						: vodVideos.map((video) => (
								<a
									href={video.link}
									target="_blank"
									rel="noopener noreferrer"
									class="group block transform cursor-pointer overflow-hidden rounded-xl border border-gray-100 bg-white shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
								>
									<div class="relative aspect-video w-full border-b-4 border-accent bg-gray-900">
										<img
											src={video.thumbnail}
											alt={video.title}
											class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
											loading="lazy"
										/>
										<div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-secondary/80 to-transparent opacity-0 transition-all group-hover:opacity-100">
											<div class="flex h-16 w-16 items-center justify-center rounded-full bg-accent shadow-[0_0_20px_rgba(255,214,0,0.6)]">
												<svg
													class="ml-1 h-8 w-8 text-secondary"
													fill="currentColor"
													viewBox="0 0 20 20"
												>
													<path
														fill-rule="evenodd"
														d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
														clip-rule="evenodd"
													/>
												</svg>
											</div>
										</div>
									</div>
									<div class="p-5">
										<h3 class="mb-2 line-clamp-2 font-body text-base font-bold leading-tight text-secondary transition-colors group-hover:text-accent">
											{video.title}
										</h3>
										<div class="flex flex-wrap gap-2">
											<span class="flex w-fit items-center rounded bg-yellow-50 px-2 py-0.5 font-body text-xs font-medium text-yellow-700">
												{copy.vodBadge}
											</span>
											{video.isUpcoming && (
												<span class="animate-pulse rounded bg-blue-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
													{video.premiereTime}
												</span>
											)}
											{video.isMembersOnly && (
												<span class="rounded bg-green-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
													Solo Miembros
												</span>
											)}
										</div>
									</div>
								</a>
							))
				}
			</div>
		</div>

		<div
			id="podcast-section"
			class:list={[
				"mt-20 border-t border-gray-100 pt-12",
				!useRealtimeVideos && podcastVideos.length === 0 && "hidden",
			]}
		>
			<div id="podcast-card">
				{
					useRealtimeVideos ? (
						<article
							class="animate-pulse rounded-3xl border border-gray-100 bg-secondary/5 p-6 md:p-10"
							aria-hidden="true"
						>
							<div class="flex flex-col items-center gap-8 md:flex-row">
								<div class="aspect-video w-full rounded-2xl bg-gray-200 md:w-2/5" />
								<div class="w-full flex-1">
									<div class="mb-6 h-6 w-40 rounded bg-secondary/10" />
									<div class="mb-4 h-7 w-full rounded bg-gray-200" />
									<div class="mb-6 h-7 w-3/4 rounded bg-gray-100" />
									<div class="mb-3 hidden h-4 w-full rounded bg-gray-100 md:block" />
									<div class="mb-6 hidden h-4 w-5/6 rounded bg-gray-100 md:block" />
									<div class="flex flex-col gap-4 sm:flex-row">
										<div class="h-12 w-40 rounded-xl bg-secondary/20" />
										<div class="h-12 w-40 rounded-xl bg-gray-100" />
									</div>
								</div>
							</div>
						</article>
					) : podcastVideos[0] ? (
						<div class="flex flex-col items-center gap-8 rounded-3xl border border-gray-100 bg-secondary/5 p-6 transition-all duration-500 hover:shadow-xl md:flex-row md:p-10">
							<div class="group relative aspect-video w-full flex-shrink-0 overflow-hidden rounded-2xl shadow-2xl md:w-2/5">
								<a
									href={podcastVideos[0].link}
									target="_blank"
									rel="noopener noreferrer"
									class="block h-full w-full"
								>
									<img
										src={podcastVideos[0].thumbnail}
										alt={podcastVideos[0].title}
										class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
									/>
									<div class="absolute inset-0 flex items-center justify-center bg-secondary/20 transition-colors group-hover:bg-secondary/40">
										<div class="flex h-14 w-14 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur-sm transition-transform group-hover:scale-110">
											<svg
												class="ml-1 h-7 w-7 text-secondary"
												fill="currentColor"
												viewBox="0 0 20 20"
											>
												<path
													fill-rule="evenodd"
													d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
													clip-rule="evenodd"
												/>
											</svg>
										</div>
									</div>
								</a>
							</div>
							<div class="flex-1 text-center md:text-left">
								<div class="mb-4 inline-flex items-center gap-2 rounded-full border border-secondary/10 bg-secondary/10 px-3 py-1">
									<span class="h-2 w-2 animate-pulse rounded-full bg-secondary" />
									<span class="font-heading text-[10px] font-bold uppercase tracking-widest text-secondary md:text-xs">
										{podcastVideos[0].isUpcoming
											? "Próximo Estreno"
											: podcastVideos[0].isMembersOnly
												? "Contenido Exclusivo"
												: copy.podcastBadge}
									</span>
								</div>
								{podcastVideos[0].isUpcoming && (
									<div class="mb-4 font-heading text-xs font-bold uppercase tracking-widest text-secondary/60">
										Se estrena: {podcastVideos[0].premiereTime}
									</div>
								)}
								<h3 class="mb-4 font-heading text-2xl font-bold leading-tight text-secondary md:text-3xl">
									{podcastVideos[0].title}
								</h3>
								<p class="mb-6 hidden max-w-lg font-body text-sm text-gray-500 md:block">
									{copy.podcastDescription}
								</p>
								<div class="flex flex-col items-center gap-5 sm:flex-row">
									<a
										href={podcastVideos[0].link}
										target="_blank"
										rel="noopener noreferrer"
										class="w-full rounded-xl bg-secondary px-8 py-3.5 font-heading text-sm uppercase tracking-wider text-white shadow-lg transition-all hover:bg-black hover:shadow-secondary/20 active:scale-95 sm:w-auto"
									>
										{copy.watchEpisode}
									</a>
									<a
										href="https://www.youtube.com/@EstoNoEsUnPodcastMiami"
										target="_blank"
										rel="noopener noreferrer"
										class="font-heading text-xs font-bold uppercase tracking-widest text-secondary/60 underline underline-offset-8 transition-colors hover:text-secondary"
									>
										{copy.allEpisodes}
									</a>
								</div>
							</div>
						</div>
					) : null
				}
			</div>
		</div>
	</div>
</section>

<script>
	import { initVideosSection } from "../scripts/videos";

	initVideosSection();
</script>
