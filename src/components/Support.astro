---

---

<section
	id="support"
	class="relative overflow-hidden border-y-8 border-primary bg-secondary py-24 text-white"
>
	<div
		class="absolute inset-0 opacity-5"
		style="background-image: radial-gradient(#FF3B3B 2px, transparent 2px); background-size: 40px 40px;"
	>
	</div>

	<div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-16 text-center">
			<h2
				class="mb-4 font-heading text-5xl uppercase tracking-widest text-white md:text-7xl"
			>
				Apoya al <span class="text-primary">Kriollo</span>
			</h2>
			<p class="mx-auto max-w-2xl font-body text-xl text-gray-400">
				Únete al canal de YouTube como miembro o tira bits en Twitch pa' apoyar
				al asere. ¡Cada granito cuenta!
			</p>
		</div>

		<div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
			<!-- YouTube Memberships -->
			<div
				class="relative transform rounded-2xl border-2 border-primary bg-gray-900 p-8 shadow-2xl transition-transform duration-300 hover:-translate-y-2 md:p-12"
			>
				<div
					class="absolute -right-6 -top-6 flex h-16 w-16 rotate-12 transform items-center justify-center rounded-full bg-primary shadow-lg"
				>
					<svg
						class="h-8 w-8 text-white"
						fill="currentColor"
						viewBox="0 0 24 24"
						><path
							d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"
						></path></svg
					>
				</div>

				<h3
					class="mb-2 font-heading text-3xl uppercase tracking-wide text-white"
				>
					Únete al Canal
				</h3>
				<p class="mb-8 font-body text-gray-400">
					Hazte miembro del canal oficial de Kristoff en YouTube y desbloquea
					beneficios exclusivos.
				</p>

				<div class="space-y-6">
					<div class="rounded-xl border border-gray-700 bg-gray-800 p-6">
						<div
							class="mb-4 flex items-center justify-between border-b border-gray-700 pb-4"
						>
							<h4 class="font-heading text-2xl uppercase text-primary">
								Aseres
							</h4>
							<span class="font-body text-xl font-bold text-white"
								>2.99 US$/mes</span
							>
						</div>
						<ul class="space-y-2 font-body text-sm text-gray-300">
							<li class="flex items-start">
								<span class="mr-2 text-primary">✓</span> Insignias de fidelización
								en comentarios y chat
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-primary">✓</span> Emojis personalizados (fuego,
								ñinga, etc.)
							</li>
						</ul>
					</div>

					<div
						class="relative scale-[1.03] transform rounded-xl border-2 border-accent bg-gray-800 p-6 shadow-xl"
					>
						<div
							class="absolute -top-3 left-1/2 -translate-x-1/2 transform rounded bg-accent px-3 py-1 font-heading text-xs uppercase tracking-wider text-secondary"
						>
							Más Popular
						</div>
						<div
							class="mb-4 mt-2 flex items-center justify-between border-b border-gray-700 pb-4"
						>
							<h4 class="font-heading text-2xl uppercase text-accent">
								Bestias
							</h4>
							<span class="font-body text-xl font-bold text-white"
								>6.99 US$/mes</span
							>
						</div>
						<ul class="space-y-2 font-body text-sm text-gray-300">
							<li class="flex items-start">
								<span class="mr-2 text-accent">✓</span> Todo lo del nivel Aseres
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-accent">✓</span> Acceso anticipado a videos
								nuevos
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-accent">✓</span> Menciones, fotos y videos
								exclusivos
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-accent">✓</span> Transmisiones en vivo exclusivas
							</li>
						</ul>
					</div>

					<div class="rounded-xl border border-primary bg-gray-800 p-6">
						<div
							class="mb-4 flex items-center justify-between border-b border-gray-700 pb-4"
						>
							<h4 class="font-heading text-2xl uppercase text-white">
								Machines
							</h4>
							<span class="font-body text-xl font-bold text-white"
								>24.99 US$/mes</span
							>
						</div>
						<ul class="space-y-2 font-body text-sm text-gray-300">
							<li class="flex items-start">
								<span class="mr-2 text-primary">✓</span> Todo lo de los niveles anteriores
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-primary">✓</span> Partidas de juegos contigo
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-primary">✓</span> Contacto en redes y respuesta
								prioritaria
							</li>
							<li class="flex items-start">
								<span class="mr-2 text-primary">✓</span> Chat en vivo exclusivo para
								miembros
							</li>
						</ul>
					</div>
				</div>

				<a
					href="https://www.youtube.com/@Kristoff9/join"
					target="_blank"
					class="btn-primary mt-8 flex w-full items-center justify-center gap-2 text-center"
				>
					<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
						><path
							d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"
						></path></svg
					>
					Unirme al Canal
				</a>
			</div>

			<!-- Twitch Support -->
			<div
				class="relative flex transform flex-col justify-between rounded-2xl border-2 border-purple-500 bg-purple-900 p-8 shadow-2xl transition-transform duration-300 hover:-translate-y-2 md:p-12"
			>
				<div
					class="absolute -right-6 -top-6 flex h-16 w-16 -rotate-12 transform items-center justify-center rounded-full bg-purple-500 shadow-lg"
				>
					<svg
						class="h-8 w-8 text-white"
						fill="currentColor"
						viewBox="0 0 24 24"
						><path
							d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"
						></path></svg
					>
				</div>

				<div>
					<h3
						class="mb-2 font-heading text-3xl uppercase tracking-wide text-white"
					>
						Apoya en Twitch
					</h3>
					<p class="mb-8 font-body text-purple-200">
						Suscríbete al canal de Twitch, tira bits en los streams y apoya
						directo al Kriollo.
					</p>

					<div
						class="mb-4 rounded-xl border border-purple-700 bg-purple-950/50 p-6"
					>
						<h4
							class="text-shadow mb-4 border-b border-purple-800 pb-2 font-heading text-xl uppercase text-white"
						>
							Beneficios VIP
						</h4>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							<div class="flex items-start gap-3">
								<div
									class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-purple-500 bg-purple-800 text-xl shadow-md"
								>
									🗿
								</div>
								<div>
									<p
										class="mb-0.5 mt-1 font-heading text-sm tracking-wide text-white"
									>
										Emotes Únicos
									</p>
									<p
										class="flex-1 font-body text-[10px] leading-tight text-gray-300"
									>
										Usa las frases del Kriollo en todos lados.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-purple-500 bg-purple-800 text-xl shadow-md"
								>
									🚫
								</div>
								<div>
									<p
										class="mb-0.5 mt-1 font-heading text-sm tracking-wide text-white"
									>
										0 Anuncios
									</p>
									<p
										class="flex-1 font-body text-[10px] leading-tight text-gray-300"
									>
										La directa limpia, sin interrupciones.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-purple-500 bg-purple-800 text-xl shadow-md"
								>
									👑
								</div>
								<div>
									<p
										class="mb-0.5 mt-1 font-heading text-sm tracking-wide text-white"
									>
										Emblema Sub
									</p>
									<p
										class="flex-1 font-body text-[10px] leading-tight text-gray-300"
									>
										Destaca en el chat como oficial.
									</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div
									class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-purple-500 bg-purple-800 text-xl shadow-md"
								>
									✨
								</div>
								<div>
									<p
										class="mb-0.5 mt-1 font-heading text-sm tracking-wide text-white"
									>
										Puntos Extra
									</p>
									<p
										class="flex-1 font-body text-[10px] leading-tight text-gray-300"
									>
										Multiplicador x1.2 en los puntos de canal.
									</p>
								</div>
							</div>
						</div>

						<!-- Meta de Subscriptores (Simulada para visual) -->
						<div class="mt-6 border-t border-purple-800/50 pt-4">
							<div
								class="mb-1 flex justify-between font-heading text-xs text-purple-200"
							>
								<span>Meta de Subs</span>
								<span>85%</span>
							</div>
							<div
								class="relative h-3 w-full overflow-hidden rounded-full border border-purple-700 bg-purple-900"
							>
								<div
									class="h-2.5 rounded-full bg-gradient-to-r from-purple-500 to-pink-500"
									style="width: 85%"
								>
								</div>
								<!-- Shimmer effect -->
								<div
									class="pointer-events-none absolute bottom-0 left-0 right-0 top-0 overflow-hidden rounded-full"
								>
									<div
										class="h-full w-full translate-x-[-150%] -skew-x-12 transform animate-[shimmer_3s_infinite] bg-white opacity-20"
									>
									</div>
								</div>
							</div>
							<p
								class="mt-2 text-center font-body text-[10px] font-bold uppercase tracking-widest text-gray-400"
							>
								APOYA EL DIRECTO DE HOY 🎉
							</p>
						</div>

						<!-- Top Bitters (Mock) -->
						<div class="mt-4 border-t border-purple-800/50 pt-4">
							<h5
								class="mb-3 text-center font-heading text-xs uppercase tracking-widest text-purple-200"
							>
								🏆 Top Bits de la Semana
							</h5>
							<div class="space-y-2">
								<div
									class="flex items-center justify-between rounded border border-purple-800/30 bg-purple-900/50 p-1.5 text-xs"
								>
									<div class="flex items-center gap-2">
										<span class="w-4 text-center font-bold text-yellow-400"
											>1</span
										>
										<span class="max-w-[100px] truncate font-body text-white"
											>El_Ruso_Habana</span
										>
									</div>
									<div class="flex items-center gap-1">
										<span class="font-bold text-purple-300">5,000</span>
										<svg
											class="h-3.5 w-3.5 text-purple-400"
											fill="currentColor"
											viewBox="0 0 24 24"
											><path d="M12 2L2 12l10 10 10-10L12 2z"></path></svg
										>
									</div>
								</div>
								<div
									class="flex items-center justify-between rounded border border-purple-800/20 bg-purple-900/30 p-1.5 text-xs"
								>
									<div class="flex items-center gap-2">
										<span class="w-4 text-center font-bold text-gray-400"
											>2</span
										>
										<span class="max-w-[100px] truncate font-body text-white"
											>Marta_Miami</span
										>
									</div>
									<div class="flex items-center gap-1">
										<span class="font-bold text-purple-300">2,500</span>
										<svg
											class="h-3.5 w-3.5 text-purple-400"
											fill="currentColor"
											viewBox="0 0 24 24"
											><path d="M12 2L2 12l10 10 10-10L12 2z"></path></svg
										>
									</div>
								</div>
								<div
									class="flex items-center justify-between rounded border border-purple-800/10 bg-purple-900/10 p-1.5 text-xs"
								>
									<div class="flex items-center gap-2">
										<span class="w-4 text-center font-bold text-orange-400"
											>3</span
										>
										<span class="max-w-[100px] truncate font-body text-white"
											>Yosvani_ElMio</span
										>
									</div>
									<div class="flex items-center gap-1">
										<span class="font-bold text-purple-300">1,000</span>
										<svg
											class="h-3.5 w-3.5 text-purple-400"
											fill="currentColor"
											viewBox="0 0 24 24"
											><path d="M12 2L2 12l10 10 10-10L12 2z"></path></svg
										>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Action Cards -->
					<div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
						<!-- Prime Gaming Notice -->
						<div
							class="flex h-full items-start gap-3 rounded-xl border border-gray-600 bg-gradient-to-r from-gray-800 to-gray-900 p-3 shadow-inner"
						>
							<div
								class="mt-0.5 flex-shrink-0 rounded bg-white p-1.5 shadow-sm"
							>
								<svg
									class="h-5 w-5 text-[#00A8E1]"
									fill="currentColor"
									viewBox="0 0 24 24"
									><path
										d="M11.906 18.069C8.36 18.069 5.378 16.59 2 13.5v3.13C5.748 19.347 8.981 20 11.968 20c7.042 0 10.021-4.048 10.021-4.048-2.671 2.375-6.524 2.117-10.083 2.117v.001z"
									></path><path
										d="M20.306 13.918c-.854-1.285-2.001-2.92-2.14-3.136-.184-.199-.399-.215-.69-.029l-1.954 1.252-2.484-4.275c-.244-.415-.55-.478-.857-.14l-2.025 2.226-1.503-1.638c-.352-.382-.734-.367-.98.056l-3.326 5.894s3.784 2.127 7.749 2.127c4.613 0 8.21-2.336 8.21-2.336z"
									></path></svg
								>
							</div>
							<div>
								<p
									class="mb-0.5 font-heading text-[12px] uppercase tracking-wide text-white"
								>
									Gratis con Prime
								</p>
								<p class="font-body text-[10px] leading-snug text-gray-400">
									Únete 1 vez al mes sin costo si tienes Amazon Prime.
								</p>
							</div>
						</div>

						<!-- Bits Notice -->
						<div
							class="flex h-full items-start gap-3 rounded-xl border border-purple-600 bg-gradient-to-r from-purple-800 to-indigo-900 p-3 shadow-inner"
						>
							<div
								class="mt-0.5 flex-shrink-0 rounded border border-purple-400 bg-purple-900 p-1.5 shadow-sm"
							>
								<svg
									class="h-5 w-5 text-purple-300"
									fill="currentColor"
									viewBox="0 0 24 24"
									><path
										d="M12 2L2 12l10 10 10-10L12 2zm0 17.5L4.5 12 12 4.5l7.5 7.5L12 19.5z"
									></path><path d="M12 7l-5 5h3v3h4v-3h3l-5-5z"></path></svg
								>
							</div>
							<div>
								<p
									class="mb-0.5 font-heading text-[12px] uppercase tracking-wide text-white"
								>
									Tira Bits en Vivo
								</p>
								<p class="font-body text-[10px] leading-snug text-purple-200">
									Donaciones directas durante el stream. ¡Manda alertas!
								</p>
							</div>
						</div>
					</div>
				</div>

				<div class="mt-8 flex w-full flex-col gap-4 sm:flex-row">
					<a
						href="https://www.twitch.tv/subs/kristoff_kriollo"
						target="_blank"
						class="flex flex-1 items-center justify-center gap-2 rounded bg-purple-600 px-8 py-4 text-center font-heading text-xl uppercase tracking-wider text-white shadow-lg transition-all hover:bg-purple-500 active:scale-95"
					>
						<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
							><path
								d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"
							></path></svg
						>
						Ir a Twitch
					</a>

					<a
						href="https://www.twitch.tv/kristoff_kriollo"
						target="_blank"
						class="flex flex-none items-center justify-center gap-2 rounded border border-purple-500 bg-purple-900 px-6 py-4 text-center font-heading text-lg uppercase tracking-wider text-purple-200 shadow-md transition-all hover:bg-purple-800 active:scale-95"
					>
						<svg
							class="h-5 w-5 text-purple-400"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M12 2L2 12l10 10 10-10L12 2zm0 17.5L4.5 12 12 4.5l7.5 7.5L12 19.5z"
							></path><path d="M12 7l-5 5h3v3h4v-3h3l-5-5z"></path></svg
						>
						Mandar Bits
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
